# Last.fm API key (scrobbles, top artists/tracks)
LASTFM_TOKEN=
# GitHub token with read:user (contribution calendar, private events); optional, falls back to public data
GITHUB_TOKEN=
# Spotify app credentials (client-credentials flow, playlist stats); optional
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Hardcover API token (books library); optional
HARDCOVER_TOKEN=
# Trakt app client ID (public profile history; read-only, no OAuth); optional
TRAKT_CLIENT_ID=
TRAKT_USERNAME=kzndotsh
# Cal.com API key (live booking slots); optional
CAL_TOKEN=
# Encrypts the secrets Alchemy keeps in its state; any long random string, and keep it
ALCHEMY_PASSWORD=
