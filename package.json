{
  "name": "kzn.sh",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "rm -rf .next/dev/cache/fetch-cache && next dev -H 127.0.0.1 -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "knip": "knip --no-config-hints",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "rm -rf .next/cache/fetch-cache && tsx --env-file=.env alchemy.run.ts --stage production",
    "deploy:ci": "rm -rf .next/cache/fetch-cache && tsx alchemy.run.ts --stage production",
    "deploy:preview": "rm -rf .next/cache/fetch-cache && tsx --env-file=.env alchemy.run.ts",
    "destroy": "tsx --env-file=.env alchemy.run.ts --stage production --destroy",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "alchemy": "^0.94.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "oxlint-tsgolint": "^7.0.2006",
    "sharp": "^0.35.3",
    "tsx": "^4.23.15",
    "ultracite": "^8.1.1",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "browserslist": "defaults, not ie <= 11",
  "engines": {
    "node": ">=20.9.0"
  }
}
