{
  "name": "kzn.sh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next/dev/cache/fetch-cache && next dev -H 127.0.0.1 -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "tsx alchemy.run.ts --stage production",
    "deploy:preview": "tsx alchemy.run.ts",
    "destroy": "tsx alchemy.run.ts --stage production --destroy"
  },
  "type": "module",
  "browserslist": "defaults, not ie <= 11",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "alchemy": "^0.93.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "wrangler": "^4.122.0"
  },
  "overrides": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
